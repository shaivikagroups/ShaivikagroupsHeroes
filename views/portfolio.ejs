<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="https://res.cloudinary.com/dzfntkzce/image/upload/v1787328790/Shaivika_Groups_LogoA12_e1cwfa.png">
    <title><%= employee.fullName %> | <%= employee.role %> | Shaivika</title>
    
    <!-- SEO & Open Graph -->
    <meta name="description" content="<%= employee.summary ? employee.summary.substring(0, 160) : `Professional portfolio of ${employee.fullName}, ${employee.role} at Shaivika.` %>">
    <link rel="canonical" href="<%= fullUrl %>">
    
    <meta property="og:title" content="<%= employee.fullName %> | <%= employee.role %> | Shaivika">
    <meta property="og:description" content="<%= employee.summary ? employee.summary.substring(0, 160) : `View the professional portfolio of ${employee.fullName}.` %>">
    <meta property="og:image" content="<%= employee.profilePhotoUrl %>">
    <meta property="og:url" content="<%= fullUrl %>">
    <meta property="og:type" content="profile">
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/portfolio.css">
    
    <!-- Person Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "<%= employee.fullName %>",
      "jobTitle": "<%= employee.role %>",
      "image": "<%= employee.profilePhotoUrl %>",
      "url": "<%= fullUrl %>",
      "worksFor": {
        "@type": "Organization",
        "name": "Shaivika Groups"
      }
    }
    </script>
</head>
<body>

    <!-- V4 Background System -->
    <div class="bg-system">
        <div class="bg-mesh"></div>
        <div class="bg-orb orb-1"></div>
        <div class="bg-orb orb-2"></div>
        <div class="bg-watermark"></div>
    </div>

    <!-- Sticky Navbar -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="#" class="nav-logo">
                <img src="https://res.cloudinary.com/dzfntkzce/image/upload/v1787327106/shaivika_goups_logo_with_background_zym7ap.png" alt="Shaivika Logo">
            </a>
            <div class="nav-links">
                <a href="#home" class="nav-link">Home</a>
                <a href="#about" class="nav-link">About</a>
                <a href="#projects" class="nav-link">Projects</a>
                <a href="#skills" class="nav-link">Skills</a>
            </div>
            <div class="nav-action">
                <% if(employee.resumeUrl) { %>
                <a href="<%= employee.resumeUrl %>" target="_blank" class="btn btn-nav-resume">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Download Resume
                </a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container">
        
        <!-- Hero Split Section -->
        <header class="hero" id="home">
            <div class="hero-grid">
                
                <!-- Left: Content -->
                <div class="hero-content reveal">
                    <span class="hero-greeting">HELLO, I'M</span>
                    <% 
                        const nameParts = employee.fullName.split(' ');
                        const firstName = nameParts[0] || '';
                        const lastName = nameParts.slice(1).join(' ') || '';
                    %>
                    <h1 class="hero-name">
                        <span class="name-first"><%= firstName %></span>
                        <% if(lastName) { %>
                            <span class="name-last"><%= lastName %></span>
                        <% } %>
                    </h1>
                    <h2 class="hero-role"><%= employee.role %></h2>
                    <% if(employee.summary) { %>
                        <p class="hero-summary"><%= employee.summary %></p>
                    <% } %>
                    
                    <div class="hero-actions">
                        <% if(employee.linkedin) { %>
                            <a href="<%= employee.linkedin %>" target="_blank" class="btn btn-linkedin">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                                LinkedIn
                            </a>
                        <% } %>
                        <% if(employee.github) { %>
                            <a href="<%= employee.github %>" target="_blank" class="btn btn-github">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                                GitHub
                            </a>
                        <% } %>
                        <a href="<%= employee.resumeUrl %>" target="_blank" class="btn btn-resume">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            View Resume
                        </a>
                    </div>
                </div>

                <!-- Right: 3D Visual -->
                <div class="hero-visual reveal">
                    <!-- Floating Geometric Orbs -->
                    <div class="float-elem float-1"></div>
                    <div class="float-elem float-2"></div>
                    <div class="float-elem float-3"></div>
                    
                    <!-- Profile Card -->
                    <div class="profile-card" id="profileCard">
                        <img src="<%= employee.profilePhotoUrl %>" alt="<%= employee.fullName %>" class="profile-img">
                        <div class="verified-badge">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            Verified Professional
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- About Section - Exact Structure from Reference -->
        <% if(employee.summary) { %>
        <section class="section about-section" id="about">
            <div class="about-grid">
                <!-- Left: Content -->
                <div class="about-left reveal">
                    <div class="about-badge">ABOUT ME</div>
                    <h2 class="about-heading">
                        Building <span class="text-gold">Solutions.</span><br>
                        Creating <span class="text-green">Impact.</span>
                    </h2>
                    <p class="about-desc"><%= employee.summary %></p>
                    
                    <div class="about-traits">
                        <div class="trait">
                            <div class="trait-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="trait-text">
                                <strong>Clean Code</strong>
                                <span>Best Practices</span>
                            </div>
                        </div>
                        <div class="trait">
                            <div class="trait-icon purple">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                            </div>
                            <div class="trait-text">
                                <strong>Problem Solver</strong>
                                <span>Analytical Mindset</span>
                            </div>
                        </div>
                        <div class="trait">
                            <div class="trait-icon" style="color: #0EA5E9; background: #E0F2FE;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>
                            <div class="trait-text">
                                <strong>Team Player</strong>
                                <span>Collaborative</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <% } %>

        <!-- Technologies Extracted from Projects -->
        <% 
            let allTech = [];
            if(employee.projects) {
                employee.projects.forEach(p => {
                    if(p.technologies) {
                        p.technologies.forEach(t => {
                            if(!allTech.includes(t.trim())) allTech.push(t.trim());
                        });
                    }
                });
            }
        %>
        <% if(allTech.length > 0) { %>
        <section class="section">
            <div class="section-header reveal" style="text-align: center;">
                <h2 class="section-title">Technologies I Work With</h2>
            </div>
            <div class="tech-grid reveal">
                <% allTech.forEach(function(tech) { %>
                    <div class="tech-card">
                        <div class="tech-dot" style="background: var(--blue);"></div>
                        <%= tech %>
                    </div>
                <% }); %>
            </div>
        </section>
        <% } %>

        <!-- Featured Projects -->
        <% if(employee.projects && employee.projects.length > 0) { %>
        <section class="section" id="projects">
            <div class="section-header reveal">
                <span class="section-subtitle">Portfolio</span>
                <h2 class="section-title">Featured Projects</h2>
            </div>
            
            <div class="project-list">
                <% employee.projects.forEach(function(project, index) { %>
                <div class="project-row reveal">
                    
                    <!-- Project Details -->
                    <div class="project-info">
                        <span class="project-num">0<%= index + 1 %></span>
                        <h3 class="project-title"><%= project.name %></h3>
                        <p class="project-desc"><%= project.description %></p>
                        
                        <div class="project-tech">
                            <% if(project.technologies) { %>
                                <% project.technologies.forEach(function(tech) { %>
                                    <span class="tech-pill"><%= tech %></span>
                                <% }); %>
                            <% } %>
                        </div>
                        
                        <div class="project-links">
                            <% if(project.projectUrl) { %>
                            <a href="<%= project.projectUrl %>" target="_blank" class="link-anim" style="color: var(--blue);">
                                Live Preview 
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                            </a>
                            <% } %>
                            <% if(project.githubUrl) { %>
                            <a href="<%= project.githubUrl %>" target="_blank" class="link-anim">
                                GitHub Source
                            </a>
                            <% } %>
                        </div>
                    </div>
                    
                </div>
                <% }); %>
            </div>
        </section>
        <% } %>

        <!-- Let's Connect CTA -->
        <section class="section connect-section reveal">
            <h2 class="connect-title">Ready to Connect?</h2>
            <div class="connect-links">
                <% if(employee.linkedin) { %>
                <a href="<%= employee.linkedin %>" target="_blank" class="btn btn-secondary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                    LinkedIn Profile
                </a>
                <% } %>
                
                <% if(employee.github) { %>
                <a href="<%= employee.github %>" target="_blank" class="btn btn-secondary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                    GitHub Profile
                </a>
                <% } %>
                
                <a href="<%= employee.resumeUrl %>" target="_blank" class="btn btn-primary">
                    View Complete Resume
                </a>
            </div>
        </section>
        
    </main>

    <!-- Footer -->
    <footer class="footer">
        <img src="https://res.cloudinary.com/dzfntkzce/image/upload/v1787327106/shaivika_goups_logo_with_background_zym7ap.png" alt="Shaivika" class="footer-logo">
        <p class="footer-text">Building People. Building Technology.</p>
        <p class="footer-text" style="margin-top: 1rem; opacity: 0.6; font-size: 0.8rem;">&copy; <%= new Date().getFullYear() %> Shaivika Groups. All rights reserved.</p>
    </footer>

    <!-- Interactive Scripts -->
    <script>
        // Reveal animation script
        const revealElements = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        obs.unobserve(entry.target);
                    }
                });
            }, { rootMargin: "0px 0px -100px 0px" });
            revealElements.forEach(el => observer.observe(el));
        } else {
            revealElements.forEach(el => el.classList.add('active'));
        }
    </script>
</body>
</html>
